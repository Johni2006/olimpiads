# Конфигурация приложения

# Google Gemini API Key
# Получить можно здесь: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Настройки Email (опционально)
# Для Gmail используйте App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Система викторин Aditi

# Настройки базы данных
# DB_PATH=olympiad_questions.db

# Настройки API сервера
# API_HOST=0.0.0.0
# API_PORT=5001
# API_DEBUG=True
